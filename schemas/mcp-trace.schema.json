{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patala.dev/schemas/mcp-trace-v1",
  "title": "Pāṭala OpenAIRE MCP Trace v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "trace_id",
    "provider",
    "connector",
    "synthetic",
    "calls"
  ],
  "properties": {
    "schema": {
      "const": "https://patala.dev/schemas/mcp-trace-v1"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "connector": {
      "type": "string",
      "minLength": 1
    },
    "captured_at": {
      "type": "string"
    },
    "client": {
      "type": [
        "string",
        "null"
      ]
    },
    "session_label": {
      "type": [
        "string",
        "null"
      ]
    },
    "synthetic": {
      "type": "boolean"
    },
    "trace_digest": {
      "type": "string"
    },
    "calls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "tool_name",
          "arguments",
          "result"
        ],
        "properties": {
          "tool_name": {
            "type": "string",
            "minLength": 1
          },
          "arguments": {
            "type": "object"
          },
          "result": {},
          "called_at": {
            "type": "string"
          },
          "openaire_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
